# Os valores reais devem ficar no arquivo .env local ou na VM.
POSTGRES_DB="monitur"
POSTGRES_USER="monitur"
POSTGRES_PASSWORD="troque-por-uma-senha-forte"
DATABASE_URL="postgresql://monitur:troque-por-uma-senha-forte@localhost:5432/monitur"
APP_PORT="3000"

# Gere um valor aleatorio longo para producao
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
SEED_ADMIN_EMAIL="admin@exemplo.com"
SEED_ADMIN_PASSWORD="troque-por-uma-senha-forte"
